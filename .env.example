# SQLGenX Environment Variables Configuration

# Default LLM Provider: groq, gemini, openai, or fallback
LLM_PROVIDER=groq

# Groq API Key
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI API Key (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API Key (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Active Database URL (Defaults to local SQLite demo database)
DATABASE_URL=sqlite:///sqlgenx_demo.db

# Security & Limits
READ_ONLY_MODE=True
MAX_ROWS_RETURNED=500
QUERY_TIMEOUT_SECONDS=15
